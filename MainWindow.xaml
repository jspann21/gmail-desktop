<Window x:Class="GmailDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gmail Desktop"
        Width="1280" Height="840" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="8" CornerRadius="10" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Close">
                                <Setter Property="ToolTip" Value="Close" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#FFE81123" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="9" Background="Transparent" />
                            <Border x:Name="Indicator" Width="3" Height="26" CornerRadius="0,3,3,0"
                                    Background="White" HorizontalAlignment="Left" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                            <Border x:Name="DropBefore" Height="2" Margin="7,-1,7,0"
                                    CornerRadius="1" Background="#FF6EA8FF"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                    Visibility="Collapsed" Panel.ZIndex="10" />
                            <Border x:Name="DropAfter" Height="2" Margin="7,0,7,-1"
                                    CornerRadius="1" Background="#FF6EA8FF"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Panel.ZIndex="10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ScaleViewport" ClipToBounds="True" SizeChanged="ScaleViewport_SizeChanged">
    <Border x:Name="WindowContentClip" CornerRadius="10" ClipToBounds="True">
    <Border x:Name="AppScaleRoot" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleSidebarColumn" Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="82" HorizontalAlignment="Left">
                    <Border Width="23" Height="18" CornerRadius="3" Background="#FFEA4335">
                        <Path Data="M 2,4 L 11.5,11 L 21,4 M 2,4 L 2,15 M 21,4 L 21,15"
                              Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" />
                    </Border>
                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gmail Desktop" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="  ·  " Foreground="#99FFFFFF" />
                    <TextBlock x:Name="TitleAccountText" Grid.Column="2" Text="No account selected"
                               Foreground="#CCFFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M 0,0 L 10,0" Stroke="White" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeIcon" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="White" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="Close_Click" Tag="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="SidebarRoot" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="13,10,13,8">
                            <ItemsControl x:Name="AccountItems" ItemsSource="{Binding Accounts}"
                                          AllowDrop="True"
                                          PreviewDragOver="AccountItems_DragOver"
                                          DragLeave="AccountItems_DragLeave"
                                          Drop="AccountItems_Drop">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AccountButtonStyle}"
                                                Click="Account_Click"
                                                PreviewMouseLeftButtonDown="Account_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="Account_PreviewMouseLeftButtonUp"
                                                PreviewMouseMove="Account_PreviewMouseMove"
                                                ToolTip="{Binding DisplayName}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="RenameAccount_Click">
                                                        <MenuItem.Header>
                                                            <Grid Width="158">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="25" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Data="M3,15 L4,10 L13,1 L17,5 L8,14 Z M11.5,2.5 L15.5,6.5"
                                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                                      StrokeLineJoin="Round" Width="18" Height="17" Stretch="Uniform"
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Rename account" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Click="RemoveAccount_Click" Foreground="{DynamicResource DangerBrush}">
                                                        <MenuItem.Header>
                                                            <Grid Width="158">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="25" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Data="M2,4 L16,4 M6,4 L6,2 L12,2 L12,4 M4,4 L5,17 L13,17 L14,4 M8,7 L8,14 M11,7 L11,14"
                                                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.4"
                                                                      StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Remove account" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid Height="42" Margin="7,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="42" Height="42">
                                                    <Ellipse Fill="{Binding Color}" />
                                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding ActiveAvatarUrl, IsAsync=True}"
                                                                        Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Email}" Foreground="#AFFFFFFF" FontSize="11"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" Width="8" Height="14" VerticalAlignment="Center"
                                                      Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      Opacity="0.38" Cursor="SizeAll">
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    <Ellipse Width="1.5" Height="1.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SidebarIconButtonStyle}" Click="AddAccount_Click" ToolTip="Add account">
                                <Grid Height="42" Margin="7,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Ellipse Stroke="#70FFFFFF" StrokeThickness="1" />
                                        <Path Data="M 0,5 L 10,5 M 5,0 L 5,10" Stroke="White" StrokeThickness="1.6"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Add account" Foreground="White" FontSize="13"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="13,6,13,12">
                        <Border Height="1" Background="#22FFFFFF" Margin="5,0,5,7" />
                        <Button Style="{StaticResource SidebarIconButtonStyle}" Click="Settings_Click" ToolTip="Settings">
                            <Grid Height="42" Margin="7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M10,1 L12,1 L13,4 C14,4.4 15,4.8 16,5.5 L19,4 L20,6 L18,8.5 C18.2,9.5 18.2,10.5 18,11.5 L20,14 L19,16 L16,14.5 C15,15.2 14,15.6 13,16 L12,19 L10,19 L9,16 C8,15.6 7,15.2 6,14.5 L3,16 L2,14 L4,11.5 C3.8,10.5 3.8,9.5 4,8.5 L2,6 L3,4 L6,5.5 C7,4.8 8,4.4 9,4 Z M11,7 A3,3 0 1 0 11,13 A3,3 0 1 0 11,7"
                                      Stroke="White" Fill="Transparent" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" />
                                <TextBlock Grid.Column="1" Text="Settings" Foreground="White" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarIconButtonStyle}" Click="ToggleSidebar_Click" ToolTip="Expand or collapse sidebar">
                            <Grid Height="42" Margin="7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="SidebarToggleChevron" Data="M12,2 L6,8 L12,14" Stroke="White"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" />
                                <TextBlock Grid.Column="1" Text="Collapse sidebar" Foreground="White" FontSize="13"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource IconButtonStyle}" Click="Back_Click" ToolTip="Back">
                                <Path Data="M 9,0 L 1,8 L 9,16 M 1,8 L 17,8" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" Width="18" Height="17" Stretch="Uniform" />
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="Refresh_Click" ToolTip="Refresh (Ctrl+R)">
                                <Path Data="M15,5 A7,7 0 1 0 16,12 M15,1 L15,5 L11,5" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Inbox_Click"
                                    ToolTip="Open inbox in this account">
                                <Path Data="M2,5 L9,1 L16,5 L16,15 L2,15 Z M2,5 L9,10 L16,5"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Fill="Transparent" Width="18" Height="17" Stretch="Uniform" />
                            </Button>

                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ToolbarAccountText" Text="Gmail" MaxWidth="220"
                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border Grid.Column="4" Background="{DynamicResource ControlHoverBrush}" CornerRadius="11" Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="MemoryModeText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="BrowserHost" Grid.Row="1" Margin="0,0,9,9"
                          Background="{DynamicResource CardBackgroundBrush}">
                        <Grid x:Name="WelcomePanel" Panel.ZIndex="10" Background="{DynamicResource WindowBackgroundBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                                <Border Width="72" Height="72" CornerRadius="18" Background="#FFEA4335" HorizontalAlignment="Center">
                                    <Path Data="M 8,14 L 36,35 L 64,14 M 8,14 L 8,56 M 64,14 L 64,56"
                                          Stroke="White" StrokeThickness="5" StrokeLineJoin="Round" />
                                </Border>
                                <TextBlock Text="Your Gmail, without all the tabs" FontSize="25" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,22,0,9" />
                                <TextBlock Text="Add an account to open the normal Gmail website in its own private, persistent profile. Only the accounts your memory mode keeps are loaded."
                                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="14" LineHeight="21" />
                                <Button Content="Add Gmail account" Click="AddAccount_Click" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center" Margin="0,22,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ErrorPanel" Panel.ZIndex="20" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                                <TextBlock Text="!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Gmail couldn't be opened" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,8" />
                                <TextBlock x:Name="ErrorMessageText" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="Retry" Click="Retry_Click" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center" Margin="0,20,0,0" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="LoadingProgress" Panel.ZIndex="30" Height="3" VerticalAlignment="Top"
                                     IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Border>
    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="10"
            Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="100" />
    </Grid>
</Window>
