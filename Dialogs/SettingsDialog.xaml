<Window x:Class="GmailDesktop.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gmail Desktop settings"
        Width="760" Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Icon="/Assets/GmailDesktop.ico"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MemoryCardStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="72" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="SelectionRing" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="SelectionFill" Fill="{DynamicResource AccentBrush}" Margin="4" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectionRing" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SelectionFill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeSegmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" Background="{DynamicResource BorderBrush}" CornerRadius="13" />
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" Direction="270" ShadowDepth="1" Opacity="0.2" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsScaleRoot" Margin="14">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource WindowBackgroundBrush}"
                CornerRadius="13" BorderThickness="0"
                SizeChanged="WindowSurface_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.28" Color="#FF000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <Grid Background="{DynamicResource SidebarBackgroundBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#FFEA4335">
                            <Path Data="M5,7 L12,12 L19,7 M5,7 L5,18 M19,7 L19,18"
                                  Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock Text="Gmail Desktop" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="  /  Settings" Foreground="#99FFFFFF" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="Close_Click" ToolTip="Close" Cursor="Hand"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBackground" Background="Transparent">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1.2"
                                          Width="11" Height="11" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBackground" Property="Background" Value="#FFE81123" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,24,30,20">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Preferences" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Tune performance, appearance, and everyday behavior."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource ControlHoverBrush}" CornerRadius="12"
                                    Padding="11,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#FF12B76A" Margin="0,0,7,0" />
                                    <TextBlock Text="Saved locally" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Memory mode" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="  Choose what stays alive when you switch accounts."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <RadioButton x:Name="LowestMemoryRadio" GroupName="MemoryMode" Style="{StaticResource MemoryCardStyle}"
                                     AutomationProperties.Name="Lowest memory mode">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#182563EB" VerticalAlignment="Center">
                                    <TextBlock Text="1" Foreground="#FF6EA8FE" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Lowest memory" FontWeight="SemiBold" FontSize="13" />
                                        <Border Background="#182563EB" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="Recommended" Foreground="#FF6EA8FE" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="One live Gmail page. Other accounts reload when selected."
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="BalancedRadio" GroupName="MemoryMode" Style="{StaticResource MemoryCardStyle}"
                                     Margin="0,8,0,0" AutomationProperties.Name="Balanced memory mode">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#18059669" VerticalAlignment="Center">
                                    <Path Data="M3,6 L9,2 L15,6 M3,12 L9,16 L15,12" Stroke="#FF12B76A" StrokeThickness="1.7"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Balanced" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="The previous account sleeps in memory for a quicker return."
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="FastRadio" GroupName="MemoryMode" Style="{StaticResource MemoryCardStyle}"
                                     Margin="0,8,0,0" AutomationProperties.Name="Fast switching memory mode">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#18EA580C" VerticalAlignment="Center">
                                    <Path Data="M10,1 L4,10 L9,10 L7,17 L14,7 L9,7 Z" Fill="#FFF79009"
                                          Width="17" Height="18" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Fast switching" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Visited accounts stay suspended and reopen almost instantly."
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.82*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.18*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Height="220">
                                    <StackPanel>
                                        <TextBlock Text="App theme" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Gmail keeps its own theme setting."
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,10" />
                                        <Border Background="{DynamicResource ControlHoverBrush}" CornerRadius="9" Padding="2"
                                                HorizontalAlignment="Stretch">
                                            <UniformGrid Columns="3">
                                                <RadioButton x:Name="SystemThemeRadio" GroupName="Theme" Content="System"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                                <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Light"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                                <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Dark"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                            </UniformGrid>
                                        </Border>
                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />
                                        <TextBlock Text="Program zoom" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Scale the app and Gmail together."
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,8" />
                                        <Border Background="{DynamicResource ControlHoverBrush}" CornerRadius="9" Padding="2"
                                                HorizontalAlignment="Stretch">
                                            <UniformGrid Columns="3">
                                                <RadioButton x:Name="SmallerScaleRadio" GroupName="AppScale" Content="Smaller"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                                <RadioButton x:Name="NormalScaleRadio" GroupName="AppScale" Content="Normal"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                                <RadioButton x:Name="LargerScaleRadio" GroupName="AppScale" Content="Larger"
                                                             Style="{StaticResource ThemeSegmentStyle}" />
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Behavior" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Height="220">
                                    <Grid Margin="14,0">
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="1" /><RowDefinition /></Grid.RowDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Close to notification area" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Keep the current session ready."
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="HideToTrayCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      AutomationProperties.Name="Close to notification area" />
                                        </Grid>
                                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                                        <Grid Grid.Row="2" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Account shortcuts" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Use Alt+1 through Alt+9."
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ShortcutsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      AutomationProperties.Name="Enable account shortcuts" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Settings are stored only on this PC" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="Save changes" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40" MinWidth="122" AutomationProperties.Name="Save settings" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="13" Background="Transparent"
                IsHitTestVisible="False" Panel.ZIndex="100" />
    </Grid>
</Window>
